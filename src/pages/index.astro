---
// src/pages/index.astro
// DEOdharma Home Page - Optimized for Astro 2026
const pageTitle = "DEOdharma | Bio-Physiological Resonance & Senior Safety";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header>
			<div class="container">
				<h1>DEOdharma</h1>
				<p class="tagline">Bio-Physiological Resonance & Human Dignity</p>
			</div>
		</header>

		<main class="container">
			<section class="hero">
				<h2>Advancing Human Stability through Systems Engineering</h2>
				<p>We leverage low-latency, air-gapped sensing technology to protect the vulnerable and empower the elderly. Our mission is <strong>Dharma</strong>: a path of service through non-invasive wellness.</p>
				<a href="mailto:rajiv@deodharma.com" class="btn">Connect with our Mission</a>
			</section>

			<div class="mission-grid">
				<div class="card">
					<h3>Senior Fall Prevention</h3>
					<p>Using no-contact mmWave sensing to monitor gait and posture. We provide ambient safety alerts without the privacy intrusion of cameras.</p>
				</div>
				<div class="card">
					<h3>Physiological Grounding</h3>
					<p>Real-time autonomic state monitoring via S3 architecture, offering acoustic bio-feedback to maintain physiological calm during stress spikes.</p>
				</div>
				<div class="card">
					<h3>Air-Gapped Privacy</h3>
					<p>Our DADAbus & S3 protocols ensure that personal bio-data remains local and secure, free from the tracking of the pharmaceutical industry.</p>
				</div>
			</div>

			<section class="legacy-note">
				<p>"From 35 years of Enterprise Architecture to the pursuit of Life Modulation. Our goal is to ensure that senior years are defined by stability, grace, and independence."</p>
				<p><strong>— Rajiv B Deo, Founder</strong></p>
			</section>
		</main>

		<footer class="footer">
			<div class="container">
				<p>&copy; 2026 DEOdharma. All Rights Reserved.</p>
				<p>A Social Impact Initiative powered by <a href="https://deocore.dev">DEOcore Technology Hub</a></p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--primary: #1a365d;
		--accent: #2c5282;
		--text: #2d3748;
		--bg: #f7fafc;
	}
	
	body {
		font-family: 'Segoe UI', system-ui, sans-serif;
		line-height: 1.6;
		color: var(--text);
		margin: 0;
		background: var(--bg);
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	header {
		background: white;
		padding: 3rem 0;
		text-align: center;
		border-bottom: 4px solid var(--primary);
	}

	h1 { color: var(--primary); font-size: 3rem; margin: 0; }
	.tagline { font-size: 1.2rem; color: var(--accent); margin-top: 0.5rem; }

	.hero { text-align: center; padding: 4rem 0; }
	.hero h2 { font-size: 2.2rem; color: var(--primary); }
	.hero p { font-size: 1.25rem; max-width: 800px; margin: 1.5rem auto; }

	.mission-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin: 4rem 0;
	}

	.card {
		background: white;
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		border-top: 5px solid var(--accent);
	}

	.card h3 { color: var(--primary); margin-top: 0; font-size: 1.5rem; }

	.legacy-note {
		background: #e2e8f0;
		padding: 2.5rem;
		border-radius: 12px;
		font-style: italic;
		border-left: 8px solid var(--primary);
		margin: 4rem 0;
	}

	.btn {
		background: var(--primary);
		color: white !important;
		padding: 1rem 2rem;
		text-decoration: none;
		border-radius: 8px;
		display: inline-block;
		font-weight: bold;
		transition: transform 0.2s;
	}

	.btn:hover { transform: translateY(-2px); }

	.footer {
		background: var(--primary);
		color: white;
		text-align: center;
		padding: 3rem 0;
		margin-top: 5rem;
	}

	.footer a { color: #bee3f8; text-decoration: underline; }
</style>
